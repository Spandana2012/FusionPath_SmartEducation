# PostgreSQL production example: postgresql+psycopg://fusionpath:password@localhost:5432/fusionpath
# Local development falls back to sqlite:///./fusionpath.db when omitted.
DATABASE_URL=sqlite:///./fusionpath.db
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_NAME=fusionpath_session
SESSION_EXPIRE_DAYS=7
SESSION_COOKIE_SECURE=false
